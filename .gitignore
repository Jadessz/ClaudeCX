# ClaudeCX handoff state lives under %LOCALAPPDATA%\CodexClaude\handoffs and
# must never be committed. These patterns catch accidental local copies.
handoffs/
CodexClaude/
claude-result.json
claude-stderr.txt
failure.json
report.json
status-before.txt
status-after.txt
last-state.sha256

# Test scratch and backups
.scratch/
scratch/
tmp/
claudecx-backups/
.claudecx-staging-*/
*.claudecx-backup-*
TestResults/

# Local secrets and editor/OS noise
.env
.env.*
*.log
.vs/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Contributor-only dashboard build dependencies
node_modules/
