{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "disableAllHooks": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "mcp__*",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(~/.claudecx/**)",
      "Edit(~/.claudecx/**)",
      "Bash(git *commit*)",
      "Bash(git *push*)",
      "Bash(git *tag*)",
      "Bash(gh *pr create*)",
      "Bash(gh *pr merge*)",
      "Bash(gh *release*)",
      "Bash(codex *)",
      "Bash(claude *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn npm publish*)",
      "Bash(docker push*)",
      "Bash(kubectl *apply*)",
      "Bash(kubectl *delete*)",
      "Bash(kubectl *patch*)",
      "Bash(kubectl *replace*)",
      "Bash(kubectl *scale*)",
      "Bash(helm *install*)",
      "Bash(helm *upgrade*)",
      "Bash(helm *uninstall*)",
      "Bash(terraform *apply*)",
      "Bash(terraform *destroy*)",
      "Bash(aws *)",
      "Bash(az *)",
      "Bash(gcloud *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(git *commit*)",
      "PowerShell(git *push*)",
      "PowerShell(git *tag*)",
      "PowerShell(gh *pr create*)",
      "PowerShell(gh *pr merge*)",
      "PowerShell(gh *release*)",
      "PowerShell(codex *)",
      "PowerShell(claude *)",
      "PowerShell(npm publish*)",
      "PowerShell(pnpm publish*)",
      "PowerShell(docker push*)",
      "PowerShell(kubectl *apply*)",
      "PowerShell(kubectl *delete*)",
      "PowerShell(terraform *apply*)",
      "PowerShell(terraform *destroy*)",
      "PowerShell(aws *)",
      "PowerShell(az *)",
      "PowerShell(gcloud *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Invoke-WebRequest *)"
    ]
  }
}

